# Copiar a .env (sin subir a git) y rellenar
# El backend del LLM: ollama (por defecto) o poligpt
LLM_BACKEND=ollama

# --- Ollama (local) ---
OLLAMA_URL=http://localhost:11434/api
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

# --- PoliGPT (opcional, requiere VPN UPV desde fuera del campus) ---
POLIGPT_BASE_URL=https://api.poligpt.upv.es/v1
POLIGPT_API_KEY=<tu_token_aqui>
POLIGPT_MODEL=poligpt
